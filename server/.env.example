JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/kec_coding_forum
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kec_coding_forum
DB_USER=kec_forum_app
DB_PASSWORD=kec_forum_pass

JWT_SECRET=replace-with-a-strong-32-byte-or-longer-secret
JWT_EXPIRATION_MINUTES=120
JWT_ISSUER=kec-coding-forum
JWT_AUDIENCE=kec-coding-forum-web
APP_TIME_ZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SERVER_COMPRESSION_ENABLED=true
FAIL_ON_DEFAULT_SECRETS=false
CSP=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'
CSP_REPORT_ONLY=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'
CSP_ENFORCED=false
HSTS_ENABLED=true
REQUEST_SECURITY_BLOCK_SUSPICIOUS=true
REQUEST_SECURITY_MAX_QUERY_LENGTH=2048
REQUEST_SECURITY_MAX_USER_AGENT_LENGTH=500
ACCOUNT_LOCKOUT_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=12
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_MAX_ATTEMPTS=5
RATE_LIMIT_PASSWORD_WINDOW_SECONDS=300
RATE_LIMIT_UPLOAD_MAX_ATTEMPTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
RATE_LIMIT_REPORT_MAX_ATTEMPTS=30
RATE_LIMIT_REPORT_WINDOW_SECONDS=600
RATE_LIMIT_MUTATION_MAX_ATTEMPTS=120
RATE_LIMIT_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_PUSH_MAX_ATTEMPTS=10
RATE_LIMIT_PUSH_WINDOW_SECONDS=600

UPLOAD_ROOT_DIR=uploads
EVENT_POSTERS_DIR=event-posters
EVENT_MEDIA_DIR=event-media

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_WEBSOCKET_ENABLED=true
NOTIFICATION_FROM_NAME=KEC Coding Forum
NOTIFICATION_FROM_ADDRESS=

WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_CONNECTION_TIMEOUT=10000
MAIL_TIMEOUT=10000
MAIL_WRITE_TIMEOUT=10000
MAIL_SSL_TRUST=smtp.gmail.com
